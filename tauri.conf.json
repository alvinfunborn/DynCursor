{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynCursor",
  "version": "1.1.1",
  "identifier": "io.github.alvinfunborn.dyncursor",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "DynCursor · 设置",
      "width": 1080, "height": 780, "minWidth": 800, "minHeight": 590,
      "center": true, "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false, "icon": ["resources/logo.ico"] }
}
